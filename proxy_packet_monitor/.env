# Proxy Packet Monitor settings. Edit and restart; nothing else in the folder holds a port.
# A real environment variable of the same name wins over this file (process_monitor sets PPM_WEB_PORT
# from its apps.toml, so keep the two equal or change it there).

# Dashboard + API: http://PPM_WEB_HOST:PPM_WEB_PORT  (slot 8008 on the process_monitor panel)
PPM_WEB_HOST=127.0.0.1
PPM_WEB_PORT=8008

# The mitmproxy the game client connects to. Leave as is; the client is pointed at this.
PPM_PROXY_HOST=127.0.0.1
PPM_PROXY_PORT=8080

# Optional. Empty = look in ./.venv, ../venv, then PATH.
PPM_MITMDUMP=
# Optional. Python for run.sh. Empty = ./.venv, ../venv, then python3.
PPM_PYTHON=

# Optional. Hosts whose downloads "Download login data" keeps (comma separated, exact names).
# PPM_CAPTURE_HOSTS=empire-html5.goodgamestudios.com,files-ak.goodgamestudios.com,langserv.public.ggs-ep.com
